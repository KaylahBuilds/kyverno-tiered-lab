aws_account_id      = "REPLACE_target-account-id"
admin_principal_arn = "REPLACE_existing-iam-role-arn"
admin_ipv4_cidrs    = ["REPLACE_private-connected-runner-cidr"]
availability_zones = ["REPLACE_first-az", "REPLACE_second-az"]
